{
  "name": "anti-google-office",
  "version": "0.1.1",
  "description": "Firefox WebExtension that prevents Google Drive from opening Microsoft Office files in Google Docs, Sheets, or Slides and breaking their layout.",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "build": "npm run build:firefox",
    "build:firefox": "node scripts/build-extension.mjs firefox",
    "build:chrome": "node scripts/build-extension.mjs chrome",
    "build:background": "BUILD_ENTRY=background-firefox vite build",
    "build:service-worker:chrome": "BUILD_ENTRY=service-worker-chromium vite build",
    "build:content": "BUILD_ENTRY=drive-menu-guard vite build",
    "build:options": "BUILD_ENTRY=options vite build",
    "build:blocked": "BUILD_ENTRY=blocked vite build",
    "check:manifest-version": "node scripts/verify-manifest-version.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "copy:assets": "node scripts/copy-extension-assets.mjs",
    "copy:assets:firefox": "node scripts/copy-extension-assets.mjs firefox",
    "copy:assets:chrome": "node scripts/copy-extension-assets.mjs chrome",
    "verify:dist:firefox": "node scripts/verify-extension-dist.mjs firefox",
    "verify:dist:chrome": "node scripts/verify-extension-dist.mjs chrome",
    "lint": "eslint .",
    "lint:ext": "web-ext lint --source-dir dist",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "license:check": "node scripts/spdx-headers.mjs --check",
    "license:headers": "node scripts/spdx-headers.mjs --write",
    "package:firefox": "npm run build && web-ext build --source-dir dist --artifacts-dir web-ext-artifacts --filename drive-office-guard-${npm_package_version}.zip --overwrite-dest",
    "preflight": "npm run license:check && npm run typecheck && npm run lint && npm run format && npm test && npm run build && npm run check:manifest-version && npm run lint:ext",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p tsconfig.config.json"
  },
  "dependencies": {
    "web-ext": "^10.1.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.9.0",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vite": "^8.0.11",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
